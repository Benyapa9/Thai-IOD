# Copy to .env.local and fill in values. Never commit real secrets.

# ── DATABASE (Azure SQL) ──────────────────────────────────
# Leave empty to run in demo mode with in-memory sample data.
DATABASE_URL=""
# DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password=<pass>;encrypt=true"

# ── AZURE STORAGE ─────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="iod-uploads"

# ── MICROSOFT ENTRA ID (Azure AD) ────────────────────────
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ── NEXTAUTH ──────────────────────────────────────────────
NEXTAUTH_SECRET=""          # openssl rand -base64 32
NEXTAUTH_URL=""             # https://<subdomain>.zygenplay.com (TBD)

# Local development only (demo mode): load source files (BG_YEAR, Actual, Master…) from a folder
# at startup. Real data stays on disk — never commit it.
DATA_IMPORT_DIR=""

# Local development only: show demo role logins on /login (ignored in production)
AUTH_DEMO_LOGIN="false"

# "Can't sign in? Contact …" link on the login page (MOM G6) — TBD by Thai IOD IT
SUPPORT_EMAIL=""

# ── AI AGENT ──────────────────────────────────────────────
ANTHROPIC_API_KEY=""        # Optional — without it the AI Agent answers in offline mode
AI_MODEL="claude-haiku-4-5"

# ── AZURE COMMUNICATION SERVICES ──────────────────────────
AZURE_COMMUNICATION_CONNECTION_STRING=""
AZURE_COMMUNICATION_SENDER_ADDRESS=""   # e.g. donotreply@<domain>.azurecomm.net

# ── SCHEDULED NOTIFICATIONS ───────────────────────────────
CRON_SECRET=""              # Bearer token for GET /api/cron/notify

# ── AZURE KEY VAULT (optional, recommended for prod) ──────
AZURE_KEY_VAULT_URL=""
